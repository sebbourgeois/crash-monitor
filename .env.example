# Web server port (default: 3000)
PORT=3000
DASHBOARD_ENABLED=true

# Which casinos to track: all | none | comma-separated keys, e.g. stake,roobet
# Known keys: stake, shuffle, roobet, goated. A site left out gets no browser
# (each one costs ~500 MB of RAM); whatever it has already archived is still
# served on its dashboard tab.
SITES=all

# Per-site switches and database files. A site is captured only if it is in
# SITES *and* its *_ENABLED flag is not false, so either can turn it off. Each
# site has its own SQLite file — never point two sites at the same DB.
STAKE_ENABLED=true
DB_PATH=crash_results.db
SHUFFLE_ENABLED=true
SHUFFLE_DB_PATH=shuffle_crash_results.db
ROOBET_ENABLED=true
ROOBET_DB_PATH=roobet_crash_results.db
GOATED_ENABLED=true
GOATED_DB_PATH=goated_crash_results.db

# Telegram notifications (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Which sites push to Telegram: all | none | comma-separated keys, e.g. stake,shuffle
TELEGRAM_SITES=all

# Desktop notifications (optional)
DESKTOP_NOTIFICATIONS_ENABLED=false

# Stall watchdog, applied per site: no crash result written for
# WATCHDOG_STALE_MS relaunches that site's browser. If a window later every
# enabled site is still stale the process exits(1) so the supervisor restarts
# it; while any other site is healthy the stalled one just keeps retrying.
# Raise to 300000 for fewer routine relaunches.
WATCHDOG_ENABLED=true
WATCHDOG_STALE_MS=180000
WATCHDOG_CHECK_MS=30000

# Scheduled browser recycle, per site. The crash pages leak while left open
# (a renderer can reach several GB after a few days), so each site's browser is
# relaunched this often, at the next round boundary. 0 disables.
BROWSER_RECYCLE_MS=21600000

# Temperature indicator on the live dashboard: how many of the most recent
# rounds are compared against the site's all-time distribution to label the
# current stretch COLD / REGULAR / HOT. 300 is roughly 2-2.5h of play; a
# bigger window is steadier but slower to react. Minimum 50.
TEMPERATURE_WINDOW=300

# Cold streak watch on the live dashboard: a "run" is consecutive rounds that
# all ended under STREAK_UNDER_X, and the widget reports how often a run of
# STREAK_MIN_LEN or more happens (and the odds of one in the next hour / day /
# week). The defaults answer "how often are there 16+ rounds in a row under
# 2.2x?" — roughly once a fortnight on Stake.
STREAK_UNDER_X=2.2
STREAK_MIN_LEN=16

