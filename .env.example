# Web server port (default: 3000)
PORT=3000
DASHBOARD_ENABLED=true

# Telegram notifications (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Desktop notifications (optional)
DESKTOP_NOTIFICATIONS_ENABLED=false

# Stall watchdog: no crash result written for WATCHDOG_STALE_MS relaunches the
# browser; still nothing one window later exits(1) so the supervisor restarts
# the service. Raise to 300000 for fewer routine relaunches.
WATCHDOG_ENABLED=true
WATCHDOG_STALE_MS=180000
WATCHDOG_CHECK_MS=30000

