# Web server port (default: 3000)
PORT=3000
DASHBOARD_ENABLED=true

# Monitored sites. Each has its own SQLite file — never point two sites at the
# same DB. Set a site to false to stop capturing it; its archived data is still
# served on its dashboard tab.
STAKE_ENABLED=true
DB_PATH=crash_results.db
SHUFFLE_ENABLED=true
SHUFFLE_DB_PATH=shuffle_crash_results.db
ROOBET_ENABLED=true
ROOBET_DB_PATH=roobet_crash_results.db

# Telegram notifications (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Desktop notifications (optional)
DESKTOP_NOTIFICATIONS_ENABLED=false

# Stall watchdog, applied per site: no crash result written for
# WATCHDOG_STALE_MS relaunches that site's browser. If a window later every
# enabled site is still stale the process exits(1) so the supervisor restarts
# it; while any other site is healthy the stalled one just keeps retrying.
# Raise to 300000 for fewer routine relaunches.
WATCHDOG_ENABLED=true
WATCHDOG_STALE_MS=180000
WATCHDOG_CHECK_MS=30000

